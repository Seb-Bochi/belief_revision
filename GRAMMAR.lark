?start: command | formula

?command: "add" formula priority?         -> add
        | "expand" formula priority?      -> expand
        | "contract" formula              -> contract
        | "revise" formula priority?      -> revise
        | "entails" formula               -> entails
        | "show"                          -> show
        | "consistent"                    -> consistent
        | "clear"                         -> clear
        | "help"                          -> help
        | "demo"                          -> demo
        | "quit"                          -> quit
        | "exit"                          -> quit

priority: INT

?formula: iff

?iff: implies
    | iff "<->" implies                   -> iff

?implies: or_expr
        | or_expr "->" implies            -> implies

?or_expr: and_expr
        | or_expr "|" and_expr            -> or_

?and_expr: not_expr
         | and_expr "&" not_expr          -> and_

?not_expr: "!" not_expr                   -> not_
         | atom

?atom: NAME                               -> atom
     | "True"                             -> truth
     | "False"                            -> falsity
     | "(" formula ")"

NAME: /[a-zA-Z][a-zA-Z0-9_]*/
INT: /[0-9]+/

%import common.WS
%ignore WS