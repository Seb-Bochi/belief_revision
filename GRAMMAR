?start: iff

?iff: implies
    | iff "<->" implies   -> iff

?implies: or_expr
    | or_expr "->" implies -> implies

?or_expr: and_expr
    | or_expr "|" and_expr -> or_

?and_expr: not_expr
    | and_expr "&" not_expr -> and_

?not_expr: "~" not_expr -> not_
         | "!" not_expr -> not_
         | atom

?atom: NAME           -> atom
     | "(" iff ")"

NAME: /[A-Za-z_][A-Za-z0-9_]*/

%import common.WS
%ignore WS

